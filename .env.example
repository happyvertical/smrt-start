# Copy to `.env`. `pnpm dev`, `pnpm build`, and every `pnpm app:*` script
# load it; it is gitignored.

# The assistant's provider key. The variable name is set by `ai.apiKeyEnv` in
# smrt.config.ts.
ANTHROPIC_API_KEY=

# Local owner setup only works on loopback.
HOST=127.0.0.1
PORT=5173

# Optional: a fixed application id and data directory. By default data lives
# in your operating system's application-data directory, never in this
# checkout.
# SMRT_APP_ID=smrt-start
# SMRT_DATA_DIR=/absolute/path/outside/this/checkout
